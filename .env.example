# Copy this file to .env and fill in values. NEVER commit .env.
# EvalMind works without any of these (baseline evaluator).

# Optional: local LLM via Ollama (free, no API key)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional: hosted LLM API key (leave blank if unused)
LLM_API_KEY=
